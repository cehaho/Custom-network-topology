{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-config-load",
    "allow-config-save",
    "allow-config-export",
    "allow-config-import",
    "allow-config-discard-import",
    "allow-ssh-browse-key",
    "allow-ssh-connect",
    "allow-ssh-write",
    "allow-ssh-resize",
    "allow-ssh-disconnect",
    "allow-ssh-forget-host-key",
    "allow-ssh-known-hosts-list",
    "allow-ssh-known-hosts-import-openssh",
    "allow-network-local-info",
    "allow-network-ping",
    "allow-network-scan",
    "allow-network-arp",
    "allow-network-neighbors",
    "allow-monitor-start",
    "allow-monitor-stop",
    "allow-alerts-notify",
    "allow-image-export"
  ]
}
